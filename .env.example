# Local development always ignores DATABASE_URL and defaults to .data/rooms.json.
# Optional: use a separate development database, never the production URL.
# LOCAL_DATABASE_URL=postgres://<dev-user>:<password>@<dev-pooled-endpoint>/neondb?sslmode=require
# LOCAL_DATABASE_URL_UNPOOLED=postgres://<dev-user>:<password>@<dev-direct-endpoint>/neondb?sslmode=require
# LOCAL_TEST_MODE=1 forces local file storage, even for a production build.
# Neon Postgres is required in production. Never commit actual credentials.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
# Run neon deploy to populate .env.local (gitignored).
# PUBLIC_ORIGIN=https://your-game.onrender.com
PORT=3001
WORKER_CONCURRENCY=2

# Save verified cooperative puzzles independently of expiring rooms.
# PUZZLE_CATALOG_FILE=.data/puzzles.json
# Idle stock: 8x8 easy/medium/hard, three fresh puzzles per difficulty.
PUZZLE_PREFILL=1
PUZZLE_STOCK_TARGET=3

# Local development uses .data/rooms.json when DATABASE_URL is omitted.
# Neon Postgres is required in production. Never commit actual credentials.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
# Run neon deploy to populate .env.local (gitignored).
# PUBLIC_ORIGIN=https://your-game.onrender.com
PORT=3001
WORKER_CONCURRENCY=2

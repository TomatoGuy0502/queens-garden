{
  "name": "queens-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server \"npm:dev:web\" \"npm:dev:server\"",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run build:worker && vitest run && vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "e2e": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:oxlint": "oxlint --deny-warnings src server shared e2e *.ts",
    "lint:eslint": "eslint . --max-warnings 0 --cache --cache-strategy content",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "npm run build:worker && node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build:worker": "esbuild server/worker.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-server/worker.js",
    "build:server": "esbuild server/index.ts server/worker.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outdir=dist-server",
    "build:web": "vue-tsc --noEmit && vite build",
    "start": "node dist-server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:server": "npm run build:worker && vitest run --config vitest.server.config.ts",
    "puzzles:seed": "npm run build:worker && node --import tsx server/tools/seedPuzzles.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@lucide/vue": "^1.61.0",
    "@neon/config": "^1.9.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

{
  "name": "queens-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "e2e": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:oxlint": "oxlint --deny-warnings src e2e *.ts",
    "lint:eslint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
